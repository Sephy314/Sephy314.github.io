---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TechBadge from '../components/TechBadge.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
const featured = projects.filter((p) => p.data.featured);
const flagship = featured[0];
const others = projects.filter((p) => p !== flagship && !p.data.side);

const skills = [
  {
    area: 'Authentication & Security',
    items: ['DPoP / RFC 9449', 'OAuth 2.0 concepts', 'JWT / JWKS', 'Key rotation', 'Replay prevention'],
  },
  {
    area: 'Distributed Systems',
    items: ['CQRS', 'Event-driven (NATS)', 'Outbox pattern', 'API gateway', 'Microservices', 'Raft consensus', 'Log replication', 'Sharding'],
  },
  {
    area: 'Infrastructure',
    items: ['Kubernetes (k3s)', 'Docker', 'PostgreSQL', 'Redis', 'GitHub Actions'],
  },
  {
    area: 'Networking & Protocols',
    items: ['TCP', 'NDJSON framing', 'Protocol design', 'WebSocket'],
  },
  {
    area: 'Languages',
    items: ['Go', 'SQL'],
  },
  {
    area: 'Practices',
    items: ['Reliability', 'Observability', 'Testing', 'CI/CD'],
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'Sephy314',
      url: 'https://sephy314.github.io',
      description:
        'Backend / distributed systems engineer. Security, protocols, infrastructure, and reliability.',
      inLanguage: 'en',
      author: { '@type': 'Person', name: 'Sephy314', url: 'https://github.com/Sephy314' },
    },
    {
      '@type': 'Person',
      name: 'Sephy314',
      url: 'https://sephy314.github.io',
      jobTitle: 'Backend / Distributed Systems Engineer',
      description:
        'Backend / distributed systems engineer focused on secure authentication, distributed architecture, network protocols, and cloud infrastructure.',
      sameAs: ['https://github.com/Sephy314', 'https://www.linkedin.com/in/davie-ryu/'],
    },
  ],
};
---

<BaseLayout title="Backend / Distributed Systems Engineer">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  </Fragment>

  <!-- ── Hero ─────────────────────────────────────────── -->
  <section class="border-b border-edge">
    <div class="mx-auto max-w-5xl px-5 py-20 sm:py-28">
      <p class="font-mono text-sm text-accent">
        <span class="text-mute">sephy@</span>~/workspace<span class="text-accent">$</span>
      </p>

      <h1 class="mt-6 max-w-2xl font-mono text-3xl font-semibold leading-tight text-bright sm:text-5xl">
        Backend / Distributed Systems Engineer
      </h1>

      <p class="mt-6 max-w-2xl text-base leading-7 text-mute sm:text-lg sm:leading-8">
        I design and build secure backend systems — sender-constrained authentication,
        command/query architectures, network protocols, and cloud infrastructure.
        Engineering-first, trade-off explicit, reliability by default.
      </p>

      <div class="mt-8 flex flex-wrap gap-3 font-mono text-sm">
        <a
          href="https://github.com/Sephy314"
          target="_blank"
          rel="noreferrer"
          class="rounded-lg border border-accent/50 px-4 py-2 text-accent transition-colors hover:bg-accent/10"
        >
          github ↗
        </a>
        <a
          href="https://www.linkedin.com/in/davie-ryu/"
          target="_blank"
          rel="noreferrer"
          class="rounded-lg border border-edge-2 px-4 py-2 text-mute transition-colors hover:border-accent/50 hover:text-accent"
        >
          linkedin ↗
        </a>
        <a
          href="/about/"
          class="rounded-lg border border-edge-2 px-4 py-2 text-mute transition-colors hover:border-accent/50 hover:text-accent"
        >
          about me →
        </a>
      </div>
    </div>
  </section>

  <!-- ── Flagship project ─────────────────────────────── -->
  <section class="mx-auto max-w-5xl px-5 py-16">
    <h2 class="font-mono text-sm uppercase tracking-wider text-mute">
      <span class="text-accent">//</span> Featured project
    </h2>

    {
      flagship && (
        <div
          class="group relative mt-6 rounded-xl border border-accent/40 bg-panel transition-colors hover:border-accent"
        >
          <a
            href={`/projects/${flagship.slug}/`}
            class="absolute inset-0 z-0 rounded-xl"
            aria-label={`${flagship.data.title} — case study`}
          ></a>

          <div class="flex items-center justify-between gap-3 border-b border-edge px-6 py-3">
            <span class="font-mono text-[0.7rem] uppercase tracking-wider text-accent">
              {flagship.data.category}
            </span>
            <span class="flex items-center gap-1.5 font-mono text-[0.7rem] text-accent">
              <span class="size-1.5 rounded-full bg-accent"></span>
              {flagship.data.status}
            </span>
          </div>

          <div class="grid gap-8 p-6 sm:grid-cols-[1.2fr_1fr] sm:p-8">
            <div>
              <h3 class="font-mono text-2xl font-semibold text-bright group-hover:text-accent">
                {flagship.data.title}
              </h3>
              <p class="mt-4 text-base leading-7 text-text">{flagship.data.tagline}</p>
              <p class="mt-3 text-sm leading-6 text-mute">{flagship.data.description}</p>

              <div class="mt-5 flex flex-wrap gap-1.5">
                {flagship.data.tech.map((t) => (
                  <TechBadge name={t} variant="accent" />
                ))}
              </div>

              <div class="mt-7 flex flex-wrap gap-3 font-mono text-sm">
                <span class="text-accent transition-transform group-hover:translate-x-0.5">
                  read case study →
                </span>
                <a
                  href={flagship.data.repo}
                  target="_blank"
                  rel="noreferrer"
                  class="relative z-10 text-mute transition-colors hover:text-accent"
                >
                  source ↗
                </a>
              </div>
            </div>

            <div class="flex flex-col justify-center gap-2 rounded-lg border border-edge bg-panel-2 p-5">
              <p class="font-mono text-[0.7rem] uppercase tracking-wider text-mute">
                engineering highlights
              </p>
              <ul class="mt-2 space-y-2">
                {flagship.data.highlights.map((h) => (
                  <li class="flex gap-2 font-mono text-xs leading-5 text-text">
                    <span class="text-accent">›</span>
                    {h}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      )
    }
  </section>

  <!-- ── Other projects ───────────────────────────────── -->
  <section class="mx-auto max-w-5xl px-5 pb-16">
    <div class="flex items-end justify-between">
      <h2 class="font-mono text-sm uppercase tracking-wider text-mute">
        <span class="text-accent">//</span> Selected projects
      </h2>
      <a href="/projects/" class="font-mono text-xs text-mute transition-colors hover:text-accent">
        all projects →
      </a>
    </div>

    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {others.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  <!-- ── Skills ───────────────────────────────────────── -->
  <section class="border-t border-edge bg-panel/40">
    <div class="mx-auto max-w-5xl px-5 py-16">
      <h2 class="font-mono text-sm uppercase tracking-wider text-mute">
        <span class="text-accent">//</span> Skills overview
      </h2>

      <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {skills.map((group) => (
          <div>
            <h3 class="font-mono text-xs uppercase tracking-wider text-accent">
              {group.area}
            </h3>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {group.items.map((item) => (
                <li>
                  <TechBadge name={item} />
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
