---
import TechBadge from './TechBadge.astro';
import type { CollectionEntry } from 'astro:content';

type Project = CollectionEntry<'projects'>;

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, tagline, category, status, languages, repo, updated } = project.data;
const href = `/projects/${project.slug}/`;
---

<div
  class="group relative flex h-full flex-col rounded-xl border border-edge bg-panel transition-colors hover:border-accent/60 hover:bg-panel-2"
>
  <!-- Stretched link: the whole card is clickable; the source link sits above it. -->
  <a href={href} class="absolute inset-0 z-0 rounded-xl" aria-label={`${title} — case study`}></a>

  <div class="flex items-center justify-between gap-3 border-b border-edge px-5 py-3">
    <span class="font-mono text-[0.7rem] uppercase tracking-wider text-accent">{category}</span>
    <div class="flex items-center gap-3 font-mono text-[0.7rem] text-mute">
      <span
        class:list={[
          'inline-flex items-center gap-1.5',
          status === 'active' ? 'text-accent' : 'text-mute',
        ]}
      >
        <span
          class:list={[
            'size-1.5 rounded-full',
            status === 'active' ? 'bg-accent' : 'bg-mute',
          ]}
        ></span>
        {status}
      </span>
      <span>rev {updated}</span>
    </div>
  </div>

  <div class="flex flex-1 flex-col gap-3 px-5 py-4">
    <h3 class="font-mono text-lg font-semibold text-bright transition-colors group-hover:text-accent">
      {title}
    </h3>
    <p class="text-sm leading-6 text-mute">{tagline}</p>

    <div class="mt-auto flex flex-wrap gap-1.5 pt-3">
      {languages.map((lang) => (
        <TechBadge name={lang} variant="accent" />
      ))}
    </div>
  </div>

  <div class="flex items-center justify-between border-t border-edge px-5 py-3 font-mono text-[0.75rem]">
    <a
      href={repo}
      target="_blank"
      rel="noreferrer"
      class="relative z-10 text-mute transition-colors hover:text-accent"
    >
      ↗ source
    </a>
    <span class="text-mute transition-transform group-hover:translate-x-0.5 group-hover:text-accent">
      details →
    </span>
  </div>
</div>
