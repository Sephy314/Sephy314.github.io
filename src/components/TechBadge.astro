---
interface Props {
  name: string;
  variant?: 'default' | 'accent' | 'muted';
}

const { name, variant = 'default' } = Astro.props;

const tones = {
  default: 'text-mute border-edge-2',
  accent: 'text-accent border-accent/40',
  muted: 'text-mute border-edge',
};

const dot = {
  default: 'bg-accent/70',
  accent: 'bg-accent',
  muted: 'bg-mute/60',
};
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-md border px-2 py-0.5 font-mono text-[0.7rem] leading-5',
    tones[variant],
  ]}
>
  <span class:list={['size-1.5 shrink-0 rounded-full', dot[variant]]} aria-hidden="true"></span>
  {name}
</span>
